{
  "name": "WikiMindMap",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // node_modules in a named volume: much faster than a bind mount on macOS.
  // ~/.claude in a named volume: the Claude Code login and settings survive rebuilds.
  "mounts": [
    "source=wikimindmap-node_modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=wikimindmap-claude-${devcontainerId},target=/home/node/.claude,type=volume"
  ],

  "containerEnv": {
    // Keep all Claude Code state (including .claude.json) inside the persisted volume.
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  "remoteUser": "node",

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [5173, 4173, 9323],
  "portsAttributes": {
    "5173": { "label": "Vite dev", "onAutoForward": "notify" },
    "4173": { "label": "Vite preview", "onAutoForward": "notify" },
    "9323": { "label": "Playwright report", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "ms-playwright.playwright",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "eslint.useFlatConfig": true,
        "files.eol": "\n"
      }
    }
  }
}
