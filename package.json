{
  "name": "wikimindmap-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WikiMindMap 2027: browse Wikipedia as a mind map",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b && eslint . && prettier --check . && vitest run",
    "test": "vitest",
    "e2e": "playwright test",
    "fixtures": "node scripts/record-fixture.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@tanstack/query-persist-client-core": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "d3-hierarchy": "^3.1.2",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
